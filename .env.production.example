# Use a long, randomly generated password. Do not commit .env.production.
POSTGRES_USER=dutyy
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=dutyy
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Bind Postgres only to the server's Tailscale IPv4 address.
POSTGRES_BIND_ADDRESS=100.x.y.z
MAX_OVERFLOW=10
POOL_SIZE=5

# Application configuration.
FRONTEND_URL=https://dutyy.example.com
ENV=production
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Email delivery used for account and password-reset messages.
RESEND_API_KEY=replace-with-your-resend-api-key
SENDER_EMAIL=dutyy@example.com

TOKEN_TTL=P2D
DEVICE_AUTH_MAX_ATTEMPTS=3
DEVICE_AUTH_BASE_URI=https://dutyy.example.com/device
DEVICE_AUTH_INTERVAL=5

# Browser session cookie.
COOKIE_NAME=__Host-dutyy-session
SECURE=true

# Optional. Defaults to the latest frontend image.
# Prefer an immutable sha-<full-commit-sha> tag after the first deployment.
WEB_IMAGE=ghcr.io/oatmeal4breakfast/dutyy-web:latest
