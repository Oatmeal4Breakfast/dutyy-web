{
	admin off
}

:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /dutyy/api/* {
		reverse_proxy {$API_UPSTREAM:app:8000} {
			header_up X-Forwarded-Proto {$FORWARDED_PROTO:https}
		}
	}

	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
